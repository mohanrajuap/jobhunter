# Copy to .env and fill in. Never commit .env.

# --- Naukri (used by the browser applier for the one-time login) ---
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# --- Email notifications (Gmail: use an App Password, not your main password) ---
SMTP_USER=
SMTP_PASS=

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
