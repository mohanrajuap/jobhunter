# Copy to .env and fill in. Never commit .env.

# --- Naukri (used by the browser applier for the one-time login) ---
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# --- Email notifications (Gmail: use an App Password, not your main password) ---
SMTP_USER=
SMTP_PASS=

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Oracle mirror (optional; see database.oracle in config.yaml) ---
# Put the real value in .env, not here — this file is committed to the repo.
ORACLE_PASSWORD=
